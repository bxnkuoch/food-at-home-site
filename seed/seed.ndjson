{"_id": "faq-1", "_type": "faq", "question": "What is Food at Home?", "answer": [{"_type": "block", "_key": "328cde5cb9c4", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "528fac51b4ee", "text": "Food at Home is a mobile app that helps you track the groceries in your kitchen, get reminded before food expires, and see how much you eat versus throw away.", "marks": []}]}], "showOnHome": true, "order": 1}
{"_id": "faq-2", "_type": "faq", "question": "Who is building it?", "answer": [{"_type": "block", "_key": "af200fb92859", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "2a7fa02180bc", "text": "Team Cronch, a group of eight Drexel students, as our 2026-27 senior design project. Our status posts show what we work on every two weeks.", "marks": []}]}], "showOnHome": true, "order": 2}
{"_id": "faq-3", "_type": "faq", "question": "How do I get the app?", "answer": [{"_type": "block", "_key": "8dfda1b3bf67", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "599aa117aa4a", "text": "We're in beta on iOS through TestFlight. See the Download page for the invite link.", "marks": []}]}], "showOnHome": true, "order": 3}
{"_id": "faq-4", "_type": "faq", "question": "Can I share an inventory with my roommates?", "answer": [{"_type": "block", "_key": "926dfc153664", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "dd568ceadb08", "text": "Yes, that's a core feature we're building: invite roommates to one household with a shared inventory and shopping list.", "marks": []}]}], "showOnHome": true, "order": 4}
{"_id": "faq-5", "_type": "faq", "question": "How are expiration dates estimated?", "answer": [{"_type": "block", "_key": "c631af2ba099", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "d57df79f037c", "text": "We use the USDA FoodKeeper data set, which covers 650+ foods and accounts for where you store the item and whether it's been opened. Treat estimates as guidance, not food-safety advice.", "marks": []}]}], "showOnHome": true, "order": 5}
