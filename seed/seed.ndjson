{"_id": "siteSettings", "_type": "siteSettings", "appName": "Food at Home", "teamName": "Team Cronch", "tagline": "Spend smarter. Waste less.", "heroTitle": "Know what's in your kitchen before it goes bad", "heroText": "Food at Home helps young adults and shared households track groceries, catch expiring food in time, and build better food habits.", "features": [{"_type": "feature", "_key": "0fd164f48e27", "title": "Scan your receipt", "description": "Snap a grocery receipt and your items land in your inventory."}, {"_type": "feature", "_key": "92fefb7e174b", "title": "Expiration reminders", "description": "Shelf-life estimates for 650+ foods, so you use things up in time."}, {"_type": "feature", "_key": "2ad06c70d3ff", "title": "Chomp & Toss metrics", "description": "See what you ate, what you tossed, and where your grocery money went."}, {"_type": "feature", "_key": "52500fda5f1b", "title": "Shared households", "description": "Invite roommates and keep one shared inventory and shopping list."}], "downloadNote": "Free beta for iPhone via TestFlight."}
